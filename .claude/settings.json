{
  "permissions": {
    "allow": ["Read", "Edit", "Write", "Bash(git add*)", "Bash(mkdir*)", "Bash(chmod*)", "Bash(./scripts/test-python.sh*)", "Bash(bash scripts/test-python.sh *)"],
    "deny": ["Bash(rm -rf*)", "Bash(git reset --hard*)", "Bash(git checkout -- *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_tool_use.py\""
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/instructions_loaded.py\""
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post_compact.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent_start.py\""
          }
        ]
      }
    ]
  }
}
